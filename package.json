    "preview": "vite preview",
    "start": "node server/index.js"
  },
  "dependencies": {
    "concurrently": "^9.2.1",
    "dotenv": "^17.2.3",
    "express": "^5.1.0",
    "openai": "^6.7.0"
  },
  "devDependencies": {
    "vite": "^6.3.5"
  }
}
